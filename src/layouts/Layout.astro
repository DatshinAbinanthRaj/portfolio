---
// src/layouts/Layout.astro
import '../styles/global.css';
import { portfolioData } from '../data/portfolio';
import Loader from '../components/Loader.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Datshin Abinanth Raj | AI Trainer & Data Lead in Helsinki",
  description = "Datshin Abinanth Raj is an AI Trainer and Human Data Lead in Helsinki, bridging 10+ years of structural precision with LLM evaluation and RLHF operations.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, portfolioData.seo.siteUrl).toString();
const ogImageUrl = `${portfolioData.seo.siteUrl}/og-image.svg`;

// JSON-LD Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${portfolioData.seo.siteUrl}/#person`,
      "name": portfolioData.personal.name,
      "alternateName": "Datshin Raj",
      "jobTitle": portfolioData.personal.title,
      "description": portfolioData.personal.heroIntro,
      "url": portfolioData.seo.siteUrl,
      "email": portfolioData.personal.email,
      "telephone": portfolioData.personal.phone,
      "image": `${portfolioData.seo.siteUrl}/images/portrait.png`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": portfolioData.personal.city,
        "addressRegion": "Uusimaa",
        "addressCountry": "FI"
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "Haaga-Helia University of Applied Sciences"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Golden Gate University"
        }
      ],
      "sameAs": [
        portfolioData.personal.socials[0].url,
        portfolioData.personal.socials[1].url,
        portfolioData.personal.socials[2].url
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${portfolioData.seo.siteUrl}/#website`,
      "url": portfolioData.seo.siteUrl,
      "name": `${portfolioData.personal.name} Portfolio`,
      "description": description,
      "publisher": {
        "@id": `${portfolioData.seo.siteUrl}/#person`
      }
    },
    ...portfolioData.projects.map((proj) => ({
      "@type": "CreativeWork",
      "name": proj.title,
      "headline": proj.title,
      "description": proj.description,
      "creator": {
        "@id": `${portfolioData.seo.siteUrl}/#person`
      },
      "keywords": proj.tags.join(", "),
      "dateCreated": proj.year
    }))
  ]
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={portfolioData.seo.keywords.join(', ')} />
    <meta name="author" content={portfolioData.personal.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <meta name="theme-color" content="#0A0A0B" />

    <!-- Preload Critical Hero Image -->
    <link rel="preload" href="/images/portrait.webp" as="image" type="image/webp" />

    <!-- JSON-LD Structured Data for High E-E-A-T and Rich Results -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Noscript Fallback to ensure crawlability even if JavaScript is disabled -->
    <noscript>
      <style>
        #intro-loader { display: none !important; }
        .custom-cursor-dot, .custom-cursor-ring { display: none !important; }
        .reveal-word { transform: none !important; opacity: 1 !important; }
        .scroll-fade-up { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body class="bg-[#0A0A0B] text-[#E5E2E3] selection:bg-[#7C5CFF]/30 selection:text-[#CABEFF] min-h-screen">
    <!-- Subtle Grain Film Texture -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Scroll Progress Bar -->
    <ScrollProgress />

    <!-- Custom Cursor -->
    <CustomCursor />

    <!-- Intro Curtain Loader -->
    <Loader />

    <!-- Sticky Navigation -->
    <Header />

    <!-- Main Content Area -->
    <main id="main-content" class="relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Lenis Smooth Inertia Scrolling & Magnetic Buttons & Scroll Trigger -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Check prefers-reduced-motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let lenis: Lenis | null = null;
      if (!prefersReducedMotion) {
        lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          touchMultiplier: 2,
        });

        function raf(time: number) {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Synchronize GSAP ScrollTrigger with Lenis
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
          lenis?.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        // Smooth Anchor Scrolling for nav links
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', function (e) {
            const href = this.getAttribute('href');
            if (href && href !== '#' && href.startsWith('#')) {
              const target = document.querySelector(href);
              if (target) {
                e.preventDefault();
                lenis?.scrollTo(target as HTMLElement, { offset: -60, duration: 1.2 });
              }
            }
          });
        });
      }

      // Scroll Fade Up Revelations for Sections & Cards (excluding above-the-fold hero)
      if (!prefersReducedMotion) {
        const fadeElements = document.querySelectorAll('main > section:not(:first-of-type), article, .timeline-entry');
        fadeElements.forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'cubic-bezier(0.22, 1, 0.36, 1)',
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                toggleActions: 'play none none none',
              },
            }
          );
        });
      }

      // Magnetic Buttons and Elements
      if (!prefersReducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const magneticItems = document.querySelectorAll('.magnetic-item');
        magneticItems.forEach((item) => {
          const el = item as HTMLElement;
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            el.style.transform = `translate3d(${x * 0.25}px, ${y * 0.25}px, 0)`;
          });
          el.addEventListener('mouseleave', () => {
            el.style.transform = 'translate3d(0, 0, 0)';
            el.style.transition = 'transform 0.4s cubic-bezier(0.22, 1, 0.36, 1)';
          });
          el.addEventListener('mouseenter', () => {
            el.style.transition = 'transform 0.1s linear';
          });
        });
      }
    </script>
  </body>
</html>

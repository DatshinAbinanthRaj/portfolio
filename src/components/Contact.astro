---
// src/components/Contact.astro
import { portfolioData } from '../data/portfolio';

const personal = portfolioData.personal;
const socials = personal.socials;
---

<section id="contact" class="w-full max-w-[1440px] mx-auto px-6 md:px-12 lg:px-20 py-24 md:py-32 relative">
  <!-- Subtle Ambient Glow -->
  <div class="absolute bottom-10 left-1/3 w-96 h-96 bg-[#7C5CFF]/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <!-- Header -->
  <div class="mb-16">
    <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#7C5CFF] mb-3">
      <span class="w-2 h-2 rounded-full bg-[#7C5CFF]"></span>
      <span>05 // Collaboration</span>
    </div>
    <!-- Huge Headline -->
    <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-[#E5E2E3] max-w-4xl leading-[1.05]">
      Let's build something <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#CABEFF] via-[#7C5CFF] to-[#4EDEA3]">great together.</span>
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    <!-- Left Column: Direct Inquiries, Large Email with Copy Toast, Socials -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div>
        <p class="font-body text-base sm:text-lg text-[#C9C4D8] leading-relaxed mb-8">
          Available for frontier AI training, rubric engineering, and data quality leadership roles—either remotely worldwide or on-site in the Helsinki metropolitan area.
        </p>

        <!-- Large Interactive Email Card with Copy Toast -->
        <div class="p-6 rounded-3xl bg-[#141418] border border-white/10 hover:border-[#7C5CFF]/60 transition-all duration-300 shadow-xl mb-8 group">
          <p class="text-xs font-mono uppercase tracking-widest text-[#938EA1] mb-2">Direct Channel</p>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <a
              href={`mailto:${personal.email}`}
              class="font-display text-lg sm:text-xl md:text-2xl font-bold text-[#CABEFF] group-hover:text-white transition-colors duration-200 break-all"
            >
              {personal.email}
            </a>

            <!-- Copy Email Button -->
            <button
              id="copy-email-btn"
              data-email={personal.email}
              class="px-4 py-2 rounded-xl text-xs font-mono font-semibold tracking-wider uppercase bg-[#1F1E24] hover:bg-[#7C5CFF] text-[#E5E2E3] hover:text-white border border-white/10 hover:border-[#7C5CFF] transition-all duration-200 flex items-center gap-1.5 self-start sm:self-auto magnetic-item shrink-0"
              aria-label="Copy email address to clipboard"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-text">Copy</span>
            </button>
          </div>
        </div>

        <!-- Phone & Location Details -->
        <div class="space-y-3 mb-8 text-sm font-mono text-[#938EA1]">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-[#18181D] flex items-center justify-center text-[#7C5CFF]">
              📍
            </span>
            <span>{personal.locationStr}</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-[#18181D] flex items-center justify-center text-[#7C5CFF]">
              📞
            </span>
            <a href={`tel:${personal.phone}`} class="hover:text-[#E5E2E3] transition-colors">{personal.phone}</a>
          </div>
        </div>
      </div>

      <!-- Magnetic Social Icons -->
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-[#938EA1] mb-4">Connect Online</p>
        <div class="flex items-center gap-3 flex-wrap">
          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-2xl bg-[#141418] hover:bg-[#7C5CFF] text-[#938EA1] hover:text-white border border-white/10 hover:border-[#7C5CFF] flex items-center justify-center transition-all duration-300 shadow-md magnetic-item"
              aria-label={`Visit Datshin's ${s.name} profile`}
            >
              {s.icon === 'linkedin' && (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              )}
              {s.icon === 'github' && (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              )}
              {s.icon === 'globe' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              )}
              {s.icon === 'mail' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Column: Accessible Form with Floating Labels & Submit Animation -->
    <div class="lg:col-span-7">
      <div class="p-8 sm:p-10 rounded-3xl bg-[#141417] border border-white/10 shadow-2xl relative">
        <h3 class="font-display text-2xl font-bold text-[#E5E2E3] mb-2">Send a Message</h3>
        <p class="text-xs sm:text-sm text-[#938EA1] mb-8">
          Inquire about consulting, full-time AI evaluation roles, or technical engineering collaborations.
        </p>

        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Name Input -->
            <div class="form-group">
              <input
                type="text"
                id="form-name"
                name="name"
                required
                placeholder=" "
                class="form-input"
              />
              <label for="form-name" class="form-label">Your Name</label>
            </div>

            <!-- Email Input -->
            <div class="form-group">
              <input
                type="email"
                id="form-email"
                name="email"
                required
                placeholder=" "
                class="form-input"
              />
              <label for="form-email" class="form-label">Your Email</label>
            </div>
          </div>

          <!-- Subject Input -->
          <div class="form-group">
            <input
              type="text"
              id="form-subject"
              name="subject"
              required
              placeholder=" "
              class="form-input"
            />
            <label for="form-subject" class="form-label">Subject / Role Opportunity</label>
          </div>

          <!-- Message Textarea -->
          <div class="form-group">
            <textarea
              id="form-message"
              name="message"
              rows="4"
              required
              placeholder=" "
              class="form-input resize-y"
            ></textarea>
            <label for="form-message" class="form-label">Project Details or Inquiry</label>
          </div>

          <!-- Submit Button with Loading -> Success Animation -->
          <button
            type="submit"
            id="form-submit-btn"
            class="w-full py-4 rounded-xl font-display text-sm font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#7C5CFF] to-[#603CE2] hover:from-[#947DFF] hover:to-[#7C5CFF] shadow-[0_0_24px_rgba(124,92,255,0.35)] transition-all duration-300 flex items-center justify-center gap-2 magnetic-item"
          >
            <!-- Normal Text -->
            <span id="btn-text">Send Transmission</span>

            <!-- Spinner Icon (hidden by default) -->
            <svg id="btn-spinner" class="w-5 h-5 animate-spin hidden" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>

            <!-- Success Icon (hidden by default) -->
            <svg id="btn-check" class="w-5 h-5 hidden text-[#4EDEA3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </form>

        <!-- Form Status Message -->
        <p id="form-status" class="mt-4 text-center text-xs font-mono text-[#4EDEA3] opacity-0 transition-opacity duration-300">
          Message sent successfully. I will get back to you shortly!
        </p>
      </div>
    </div>
  </div>

  <!-- Toast Notification for Copied Email -->
  <div
    id="copy-toast"
    class="fixed bottom-8 right-8 z-50 px-5 py-3 rounded-2xl bg-[#1C1B20]/95 backdrop-blur-xl border border-[#7C5CFF]/60 text-xs font-mono font-semibold text-[#E5E2E3] shadow-2xl flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none"
  >
    <span class="w-2 h-2 rounded-full bg-[#4EDEA3]"></span>
    <span>Email copied to clipboard!</span>
  </div>
</section>

<script>
  // Copy Email Functionality with Toast
  const copyBtn = document.getElementById('copy-email-btn');
  const toast = document.getElementById('copy-toast');
  const copyBtnText = document.getElementById('copy-btn-text');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      if (copyBtnText) copyBtnText.textContent = 'Copied!';
      if (toast) {
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
          if (copyBtnText) copyBtnText.textContent = 'Copy';
        }, 2500);
      }
    } catch (err) {
      console.error('Failed to copy email:', err);
    }
  });

  // Contact Form Handling with Loading -> Success Animation
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('form-submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const btnCheck = document.getElementById('btn-check');
  const formStatus = document.getElementById('form-status');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!submitBtn || !btnText || !btnSpinner || !btnCheck) return;

    // Loading State
    btnText.textContent = 'Transmitting...';
    btnSpinner.classList.remove('hidden');
    submitBtn.setAttribute('disabled', 'true');

    // Simulate reliable dispatch
    setTimeout(() => {
      btnSpinner.classList.add('hidden');
      btnCheck.classList.remove('hidden');
      btnText.textContent = 'Message Dispatched';

      if (formStatus) {
        formStatus.classList.remove('opacity-0');
      }

      contactForm.reset();

      // Reset after 4s
      setTimeout(() => {
        btnCheck.classList.add('hidden');
        btnText.textContent = 'Send Transmission';
        submitBtn.removeAttribute('disabled');
        if (formStatus) {
          formStatus.classList.add('opacity-0');
        }
      }, 4000);
    }, 1200);
  });
</script>

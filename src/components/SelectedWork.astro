---
// src/components/SelectedWork.astro
import { portfolioData } from '../data/portfolio';

const projects = portfolioData.projects;
---

<section id="selected-work" class="w-full max-w-[1440px] mx-auto px-6 md:px-12 lg:px-20 py-24 md:py-32">
  <!-- Section Heading -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
    <div>
      <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#7C5CFF] mb-3">
        <span class="w-2 h-2 rounded-full bg-[#7C5CFF]"></span>
        <span>01 // Portfolio</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#E5E2E3]">
        Selected Work &amp; Systems
      </h2>
    </div>
    <p class="font-body text-sm sm:text-base text-[#938EA1] max-w-md">
      A curated bento of production systems spanning autonomous conversational AI, rubric evaluation frameworks, and European structural engineering.
    </p>
  </div>

  <!-- Asymmetric Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8">
    {projects.map((project, index) => {
      // Asymmetric layout spans (7/5, 5/7)
      const spanClass = index % 4 === 0 
        ? 'md:col-span-7' 
        : index % 4 === 1 
          ? 'md:col-span-5' 
          : index % 4 === 2 
            ? 'md:col-span-5' 
            : 'md:col-span-7';

      return (
        <article
          data-cursor-project
          class={`project-tilt-card group relative rounded-2xl md:rounded-3xl bg-[#141417] border border-white/[0.08] hover:border-[#7C5CFF]/50 overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] shadow-[0_8px_30px_rgb(0,0,0,0.2)] hover:shadow-[0_20px_50px_rgba(124,92,255,0.2)] flex flex-col ${spanClass}`}
        >
          <!-- Project Visual Container with Clip-Path Reveal & Parallax -->
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#0A0A0B]">
            <img
              src={project.image}
              alt={project.alt}
              loading="lazy"
              width="1200"
              height="800"
              class="project-img w-full h-full object-cover object-center transform transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#141417] via-transparent to-transparent opacity-70 group-hover:opacity-40 transition-opacity duration-300"></div>

            <!-- Top Header Metadata: Year & Category -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
              <span class="px-3 py-1 rounded-full text-[11px] font-mono font-semibold tracking-wider uppercase bg-[#0A0A0B]/80 backdrop-blur-md text-[#CABEFF] border border-white/10">
                {project.category}
              </span>
              <span class="px-3 py-1 rounded-full text-[11px] font-mono tracking-wider bg-[#0A0A0B]/80 backdrop-blur-md text-[#938EA1] border border-white/10">
                {project.year}
              </span>
            </div>
          </div>

          <!-- Project Content Details -->
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
            <div>
              <!-- Title -->
              <h3 class="font-display text-xl sm:text-2xl font-bold text-[#E5E2E3] group-hover:text-[#CABEFF] transition-colors duration-200 mb-3 flex items-center justify-between">
                <span>{project.title}</span>
                <span class="transform translate-x-1 -translate-y-1 opacity-0 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 text-[#7C5CFF]">
                  ↗
                </span>
              </h3>

              <!-- Short Description -->
              <p class="font-body text-sm text-[#938EA1] leading-relaxed mb-6">
                {project.description}
              </p>
            </div>

            <div>
              <!-- One-Line Measurable Result -->
              <div class="p-3.5 rounded-xl bg-[#1C1B20] border border-[#7C5CFF]/20 mb-6 flex items-start gap-2.5">
                <span class="text-[#4EDEA3] text-sm mt-0.5">✦</span>
                <p class="text-xs font-mono text-[#E5E2E3] leading-snug">
                  <span class="text-[#4EDEA3] font-semibold">Impact:</span> {project.result}
                </p>
              </div>

              <!-- Tags List -->
              <div class="flex flex-wrap gap-2 pt-2 border-t border-white/[0.06]">
                {project.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-mono tracking-wide bg-[#201F25] text-[#C9C4D8] border border-white/5">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Clickable overlay if link exists -->
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="absolute inset-0 z-20"
              aria-label={`View ${project.title} live system`}
            ></a>
          )}
        </article>
      );
    })}
  </div>
</section>

<style>
  .project-tilt-card {
    transform-style: preserve-3d;
    will-change: transform;
  }
</style>

<script>
  // 3D Tilt Effect on mouse movement
  function initCardTilt() {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cards = document.querySelectorAll('.project-tilt-card');

    cards.forEach((card) => {
      const cardEl = card as HTMLElement;

      cardEl.addEventListener('mousemove', (e) => {
        const rect = cardEl.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -5;
        const rotateY = ((x - centerX) / centerX) * 5;

        cardEl.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
      });

      cardEl.addEventListener('mouseleave', () => {
        cardEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCardTilt);
  } else {
    initCardTilt();
  }
</script>
